%% main response environment
\newenvironment{responseletter}[1][]{
\clearpage
\onecolumn
\zlabel{responsehelper:start} % physical page where the response starts, see example/Makefile
\nolinenumbers%
\fontsize{12}{13.5}\selectfont

\newcounter{myfigure} % to be used for extra refs
\setcounter{myfigure}{\thefigure}
\renewcommand{\themyfigure}{\arabic{myfigure}}
\setcounter{page}{1} % reset counters
\setcounter{table}{0}
\setcounter{figure}{0}
\renewcommand{\thefigure}{} % keep figures and tables without any numbers
\renewcommand{\thetable}{}
\let\revlabel\label
\renewcommand{\label}[1]{} % prevent multiple labels as paste
\pagestyle{responseletterstyle}
\AtEndDocument{\thispagestyle{responseletterstyle}}

% force figures and tables to be here
\makeatletter
\let\origtable\table%
\let\endorigtable\endtable%
\let\origfigure\figure%
\let\endorigfigure\endfigure%
\renewenvironment{table}[1][]{\origtable[ht]}{\endorigtable}
\renewenvironment{table*}[1][]{\origtable[ht]}{\endorigtable}
\renewenvironment{figure}[1][]{\origfigure[ht]}{\endorigfigure}
\renewenvironment{figure*}[1][]{\origfigure[ht]}{\endorigfigure}
\makeatother

%% cover letter
\newenvironment{coverletter}[1][]{
\setlength{\parindent}{0cm}
}{
\newpage
}

}{
\newpage
}

