%% colors
\newcommand{\therevcolor}{blue}
\newcommand{\therevresponsecolor}{teal}
\newcommand{\revcolor}{\color{\therevcolor}}
\newcommand{\revresponsecolor}{\color{\therevresponsecolor}}

%% copy and paste text changes
\newcommand{\revnocopy}[1]{{\revcolor#1}}
\newcommand{\revpaste}[1]{{\@nameuse{revclipboard@#1}}}
%\newcommand{\rev}[2]{\label{rev-#1}\llabel{rev-line-#1}\Copy{#1}{{\revcolor#2}}}
\NewEnviron{rev}[1]{%
  \label{rev-#1}\llabel{rev-line-#1}% normal label and label with exact location
  \global\expandafter\edef\csname revclipboard@#1\endcsname{% copy
    \noexpand\revcolor\unexpanded\expandafter{\BODY}}%
  {\revcolor\BODY}%
}

% Counter reset whenever \revresponseto is called
\newcounter{revcomment}

\newcommand{\revresponseto}[1]{%
  \setcounter{revcomment}{0}%
  \newpage%
  \noindent\underline{\Large\textbf{Response to #1:}}\\%
}

\tcbset{
  contbox/.style={
    breakable,
    enhanced,
    colback=white,
    colframe=black,
    before upper={},
    segmentation style={dashed, gray}
  }
}

\newtcolorbox{revresponsebox}{
  enhanced,
  colback=white,
  coltext=\therevresponsecolor,
  boxrule=0pt,
  left=0pt,right=0pt,top=0pt,bottom=0pt,
  frame hidden,
  sharp corners
}

\newtcolorbox{revresponsechanges}{
  enhanced,
  colback=white,
  coltext=\therevcolor,
  boxrule=0pt,
  left=0pt,right=0pt,top=0pt,bottom=0pt,
  frame hidden,
  sharp corners
}

\NewDocumentEnvironment{revcomment}{s}
{%
  \IfBooleanTF{#1}
    {% unnumbered comment

      \def\rev@num{}%

      \NewDocumentEnvironment{revresponse}{}%
      {%
        \par\vspace{1em}%
        \begin{revresponsebox}
        \noindent{\textbf{RESPONSE:}}%
        \par\smallskip
      }
      {%
        \par
        \end{revresponsebox}
        \vspace{1em}
      }

      \begin{tcolorbox}[contbox]
      \noindent\textbf{COMMENT:}\par
    }
    {% numbered comment

      \stepcounter{revcomment}%
      \edef\rev@num{\arabic{revcomment}}%

      \NewDocumentEnvironment{revresponse}{}%
      {%
        \par\vspace{1em}%
        \begin{revresponsebox}
        \noindent{\textbf{RESPONSE \rev@num:}}%
        \par\smallskip
      }
      {%
        \par
        \end{revresponsebox}
        \vspace{1em}
      }

      \ifnum\value{revcomment}>1
        \vspace{3em}%
      \fi

      \begin{tcolorbox}[contbox]
      \noindent\textbf{COMMENT \rev@num:}\par
    }%
}
{%
  \end{tcolorbox}
}

