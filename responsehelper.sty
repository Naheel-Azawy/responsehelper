\makeatletter
\newcommand{\inplacefigure}[4]{%
  \par\medskip
  \noindent
  \begin{minipage}{\linewidth}
    \begin{center}
      \includegraphics[width=#1]{#2}
    \end{center}
    \revcolor
    {\small{}Fig. %
    \ifthenelse{\equal{#3}{}}{}{%
      \@ifundefined{r@fig:#3}{%
        % Reference does not exist: create a new number
        \refstepcounter{myfigure}%
        \revlabel{fig:#3}%
        \themyfigure
      }{%
        % Reference exists: use its number
        \ref{fig:#3}%
      }%
    }%
    : #4\par}
    \vspace{.5em}
  \end{minipage}
  \par\medskip
}
\makeatother

% helper for inlined tables, TODO: update referencing as for figures above
\newcommand{\inplacetable}[4]{%
  \par\medskip
  \noindent
  \centering
  \begin{minipage}{#1}
    \revcolor\small
    {\centering{}TABLE %
    \ifthenelse{\equal{#3}{}}{}{\ref{tbl:#3}}: %
    #4\par}
    #2
  \end{minipage}
  \par\medskip
}

